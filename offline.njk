<!doctype html>
<html lang="en-us">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Offline · University Physics</title>
    <!-- Deliberately self-contained: no CSS/JS/font requests, so this page
         renders from the precache even with an empty runtime cache. -->
    <style>
      :root {
        color-scheme: light dark;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: system-ui, -apple-system, sans-serif;
        background: #ffffff;
        color: #1a1a1a;
      }
      @media (prefers-color-scheme: dark) {
        body {
          background: #1c1c1c;
          color: #e6e6e6;
        }
      }
      main {
        max-width: 32rem;
        margin: 2rem;
        padding: 2rem;
        border: 1px solid rgba(128, 128, 128, 0.4);
        border-radius: 8px;
        text-align: center;
      }
      h1 {
        font-size: 1.5rem;
        margin: 0 0 1rem;
      }
      p {
        line-height: 1.6;
        margin: 0 0 1rem;
      }
      a {
        color: inherit;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>You&rsquo;re offline</h1>
      <p>
        This page isn&rsquo;t available offline. Pages you have already visited, including their
        figures and math, remain available from the table of contents.
      </p>
      <p><a href="/">Return to the table of contents</a></p>
    </main>
  </body>
</html>
